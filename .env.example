# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações do Banco de Dados (MariaDB/MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=notificacoes_db
DB_USER=root
DB_PASSWORD=

# Configurações de E-mail (SMTP / MailPit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Autenticação JWT
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande
JWT_EXPIRES_IN=1h